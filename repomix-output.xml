                  ),
                  const SizedBox(height: 16),
                  const Text('Password otomatis: Surveyor123!',
                      style: TextStyle(color: Colors.grey, fontSize: 12)),
                ],
              ),
              actions: [
                TextButton(
                  onPressed: _isCreatingUser ? null : () => Navigator.pop(context),
