/// Cek apakah sebuah titik (lat, lng) berada di dalam poligon Kota Cirebon,
/// menggunakan algoritma ray-casting standar.
bool isInsideCirebon(double lat, double lng) {
  final polygon = cirebonBoundaryPolygon;
  bool inside = false;
  int j = polygon.length - 1;
  for (int i = 0; i < polygon.length; i++) {
    final xi = polygon[i][0];
    final yi = polygon[i][1];
    final xj = polygon[j][0];
    final yj = polygon[j][1];
    final intersects = ((yi > lat) != (yj > lat)) &&
        (lng < (xj - xi) * (lat - yi) / (yj - yi) + xi);
    if (intersects) inside = !inside;
    j = i;
  }
  return inside;
}
